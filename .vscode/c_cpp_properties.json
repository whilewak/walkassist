{
  "configurations": [
    {
      "name": "Arduino Nano 33 IoT",
      "compilerPath": "${env:HOME}/Library/Arduino15/packages/arduino/tools/arm-none-eabi-gcc/7-2017q4/bin/arm-none-eabi-g++",
      "intelliSenseMode": "gcc-arm",
      "cStandard": "gnu11",
      "cppStandard": "gnu++11",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/samd/1.8.14/cores/arduino",
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/samd/1.8.14/cores/arduino/api/deprecated",
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/samd/1.8.14/cores/arduino/api/deprecated-avr-comp",
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/samd/1.8.14/variants/nano_33_iot",
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/samd/1.8.14/libraries/**",
        "${env:HOME}/Library/Arduino15/packages/arduino/tools/CMSIS/4.5.0/CMSIS/Include",
        "${env:HOME}/Library/Arduino15/packages/arduino/tools/CMSIS-Atmel/1.2.0/CMSIS/Device/ATMEL",
        "${env:HOME}/Documents/Arduino/libraries/**"
      ],
      "forcedInclude": [
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/samd/1.8.14/cores/arduino/Arduino.h"
      ],
      "defines": [
        "F_CPU=48000000L",
        "ARDUINO=10607",
        "ARDUINO_SAMD_NANO_33_IOT",
        "ARDUINO_ARCH_SAMD",
        "CRYSTALLESS",
        "__SAMD21G18A__",
        "USB_VID=0x2341",
        "USB_PID=0x8057",
        "USBCON"
      ]
    }
  ],
  "version": 4
}
